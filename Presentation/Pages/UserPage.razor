@page "/users"

<AuthorizeView Policy="@AdminPermissions.UserManagement">
    <Authorized>
        <PageTitle>CamCon | User</PageTitle>

        <style>
            .newsfeed-wrapper {
                background-color: #FBFBFE;
                min-height: 100vh;
                padding: 20px;
                font-family: 'Inter', sans-serif;
            }

            .header-section {
                margin-bottom: 32px;
                border-left: 4px solid #3F51B5;
                padding-left: 24px;
            }

            .main-title {
                font-weight: 800;
                font-size: 2.5rem;
                background: linear-gradient(135deg, #3F51B5 0%, #9C27B0 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                letter-spacing: -1.5px;
                line-height: 1.1;
            }

            .sub-title {
                font-weight: 600;
                font-size: 1rem;
                color: #6C757D;
                margin-top: 4px;
                letter-spacing: 0.5px;
            }

            .feed-container {
                max-width: 1200px;
                margin: 0 auto;
            }
        </style>
        
        <div class="newsfeed-wrapper">
            <div class="header-section">
                <div class="main-title">Campus Connect</div>
                <div class="sub-title">Users</div>
            </div>

            <div class="feed-container">
            
                <MudTable Class="standard-table mt-1" Loading="_isLoading" Items="UserList" Hover Bordered Striped FixedFooter Dense Filter="new Func<ApplicationUserModel, bool>(FilterFunction)">
                    <ColGroup>
                        <col />
                        <col />
                        <col />
                        <col style="width: 1%;" />
                    </ColGroup>
                    <ToolBarContent>
                        <MudText Typo="Typo.h6">Users</MudText>
                        <MudSpacer />
                        <MudTextField @bind-Value="searchString" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                        <MudIconButton OnClick="() => OpenDialog(Enums.Action.Create, new ApplicationUserModel())" Icon="@Icons.Material.Filled.Add"></MudIconButton>
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Department</MudTh>
                        <MudTh>Disabled</MudTh>
                        <MudTh>Action</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="row">
                        <MudTd DataLabel="Sign">@row.Name</MudTd>
                        <MudTd DataLabel="Sign">@row.ProfileInformation?.MyOrganization?.OrganizationName</MudTd>
                        <MudTd>
                            @if (row.IsDisabled)
                            {
                                <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled">Disabled</MudChip>
                            }
                        </MudTd>
                        <MudTd>
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert" AnchorOrigin="Origin.TopLeft" TransformOrigin="Origin.TopRight" Dense>
                                <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="() => OpenDialog(Enums.Action.Update, row)" Label="Edit" />
                                <MudMenuItem Icon="@Icons.Material.Filled.Block" OnClick="() => ToggleDisableUser(row)" Label="Disable/Enable" />
                            </MudMenu>
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager />
                    </PagerContent>
                </MudTable>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Error" Class="ma-4">You do not have permission to access this page.</MudAlert>
    </NotAuthorized>
</AuthorizeView>


@code {
    private List<ApplicationUserModel> UserList = new();

    private string searchString = string.Empty;

    private bool _isLoading;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _isLoading = true;
        StateHasChanged();
        UserList = await _userService.GetAllUsers();
        _isLoading = false;
        
        StateHasChanged();
    }

    private bool FilterFunction(ApplicationUserModel element) => FilterFunction(element, searchString);

    private bool FilterFunction(ApplicationUserModel element, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (element.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    }

    private async Task OpenDialog(Enums.Action action, ApplicationUserModel org)
    {
        var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

        var parameters = new DialogParameters();
        parameters.Add("Action", action);
        parameters.Add("Model", org);

        var dialog = await _dialogService.ShowAsync<EditUserDialog>(string.Empty, parameters, options);

        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await OnInitializedAsync();
        }
    }

    private async Task ToggleDisableUser(ApplicationUserModel user)
    {
        var action = user.IsDisabled ? "enable" : "disable";
        var parameters = new DialogParameters
        {
            { "Description", $"Are you sure you want to {action} \"{user.Name}\"?" }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var dialog = await _dialogService.ShowAsync<ConfirmDialog>(user.IsDisabled ? "Enable User" : "Disable User", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            try
            {
                await _userService.DisableUserAsync(user.Id, !user.IsDisabled);
                _snackBar.Add($"User \"{user.Name}\" {(user.IsDisabled ? "enabled" : "disabled")} successfully", Severity.Success);
                await OnInitializedAsync();
            }
            catch (Exception ex)
            {
                _snackBar.Add(ex.Message, Severity.Error);
            }
        }
    }
}
