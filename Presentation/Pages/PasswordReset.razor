@page "/passwordreset/{Guid}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@layout AnonymousLayout
@attribute [AllowAnonymous]

<PageTitle>Reset Password | CampusConnect</PageTitle>

<style>
    .reset-wrapper {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        font-family: 'Inter', sans-serif;
    }

    .reset-card {
        background: white;
        border-radius: 24px;
        padding: 3rem 2.5rem;
        max-width: 480px;
        width: 100%;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    }

    .reset-title {
        font-size: 2rem;
        font-weight: 800;
        background: linear-gradient(135deg, #3F51B5 0%, #9C27B0 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 0.5rem;
        text-align: center;
    }

    .reset-subtitle {
        font-size: 0.95rem;
        color: #6C757D;
        text-align: center;
        margin-bottom: 2rem;
    }

    .expired-message {
        text-align: center;
        padding: 2rem;
    }

    .expired-icon {
        font-size: 4rem;
        color: #f44336;
        margin-bottom: 1rem;
    }

    .success-icon {
        font-size: 4rem;
        color: #4caf50;
        margin-bottom: 1rem;
    }

    .modern-input {
        border-radius: 12px !important;
        margin-bottom: 1rem !important;
    }

    .submit-button {
        background: linear-gradient(135deg, #3F51B5 0%, #9C27B0 100%) !important;
        border-radius: 12px !important;
        padding: 14px !important;
        color: white !important;
        font-weight: 600 !important;
        text-transform: none !important;
        margin-top: 1rem !important;
    }

    .back-link {
        text-align: center;
        margin-top: 1.5rem;
    }
</style>

<AuthorizeView>
    <NotAuthorized>
        <div class="reset-wrapper">
            <div class="reset-card">
                @if (isExpired)
                {
                    <div class="expired-message">
                        <div class="expired-icon">⏰</div>
                        <h2>Link Expired</h2>
                        <p style="color: #6C757D;">This password reset link has expired or is invalid.</p>
                        <MudButton Href="/" Variant="Variant.Text" Style="color: #3F51B5; margin-top: 1rem;">
                            Back to Login
                        </MudButton>
                    </div>
                }
                else if (isSuccess)
                {
                    <div class="expired-message">
                        <div class="success-icon">✓</div>
                        <h2>Password Reset!</h2>
                        <p style="color: #6C757D;">Your password has been successfully reset.</p>
                        @* <MudButton Href="/" Variant="Variant.Filled" Class="submit-button" FullWidth="true" Style="margin-top: 1rem;"> *@
                        @*     Go to Login *@
                        @* </MudButton> *@
                    </div>
                }
                else
                {
                    <div class="reset-title">Reset Password</div>
                    <div class="reset-subtitle">Enter your new password below.</div>

                    <MudForm>
                        <MudTextField
                            @bind-Value="newPassword"
                            Label="New Password"
                            InputType="InputType.Password"
                            Variant="Variant.Outlined"
                            Class="modern-input"
                            FullWidth="true"
                            Required="true" />

                        <MudTextField
                            @bind-Value="confirmPassword"
                            Label="Confirm Password"
                            InputType="InputType.Password"
                            Variant="Variant.Outlined"
                            Class="modern-input"
                            FullWidth="true"
                            Required="true" />

                        <MudButton
                            OnClick="ResetPassword"
                            Variant="Variant.Filled"
                            Class="submit-button"
                            FullWidth="true"
                            Disabled="isLoading">
                            @if (isLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Color="Color.Inherit" Indeterminate="true" Class="mr-2" />
                                <span>Resetting...</span>
                            }
                            else
                            {
                                <span>Reset Password</span>
                            }
                        </MudButton>
                    </MudForm>

                    <div class="back-link">
                        <MudLink Href="/" Style="color: #3F51B5; font-weight: 600;">Back to Login</MudLink>
                    </div>
                }
            </div>
        </div>
    </NotAuthorized>
    <Authorized>
        @{
            NavigationManager.NavigateTo("/");
        }
    </Authorized>
</AuthorizeView>

@code {
    [Parameter] public string Guid { get; set; } = string.Empty;
    [Inject] private IUserService UserService { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private bool isLoading = false;
    private bool isExpired = false;
    private bool isSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        // Validate GUID by attempting to use it (the API will check the cache)
        if (string.IsNullOrEmpty(Guid))
        {
            isExpired = true;
        }
    }

    private async Task ResetPassword()
    {
        if (string.IsNullOrWhiteSpace(newPassword) || string.IsNullOrWhiteSpace(confirmPassword))
        {
            Snackbar.Add("Please fill in all fields", Severity.Error);
            return;
        }

        if (newPassword != confirmPassword)
        {
            Snackbar.Add("Passwords do not match", Severity.Error);
            return;
        }

        if (newPassword.Length < 6)
        {
            Snackbar.Add("Password must be at least 6 characters", Severity.Error);
            return;
        }

        isLoading = true;
        try
        {
            var result = await UserService.ResetPasswordAsync(Guid, newPassword, confirmPassword);
            if (result.IsSuccess)
            {
                isSuccess = true;
            }
            else
            {
                if (result.Error.Description.Contains("expired") || result.Error.Description.Contains("Invalid"))
                {
                    isExpired = true;
                }
                else
                {
                    Snackbar.Add(result.Error.Description, Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("An error occurred. Please try again.", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }
}
