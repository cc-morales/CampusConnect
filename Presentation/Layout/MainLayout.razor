@using global::Shared.Component.Components
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor.Extensions
@using Presentation.Authentication
@using Presentation.Shared

@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<AuthorizeView>
    <Authorizing>
        <LoaderComponent></LoaderComponent>
    </Authorizing>
    <Authorized>
        <MudLayout>
            <MudAppBar Elevation="1" Dense>
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
                <MudLink Href="/" Underline="Underline.None" Style="color:white;">
                    <MudText Typo="Typo.h6" Class="mr-4">Campus Connect</MudText>
                </MudLink>
                <MudSpacer />
                <MudMenu ListClass="notify-container" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <ActivatorContent>
                        <MudBadge Content="@NotificationList.Where(c => !c.IsRead).ToList().Count" Color="Color.Inherit" Overlap="true" Class="mx-6 my-4">
                            <MudIcon Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit"></MudIcon>
                        </MudBadge>
                    </ActivatorContent>
                    <ChildContent>
                        <div class="d-flex justify-space-between align-center px-3 py-2" @onclick:stopPropagation="true">
                            <MudText Typo="Typo.subtitle2"><b>Notifications</b></MudText>
                            @if (NotificationList.Count > 0)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="ClearAllNotifications">Clear All</MudButton>
                            }
                        </div>
                        <MudDivider />
                        @if (NotificationList.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="pa-4" Align="Align.Center" Style="color: grey;">No notifications</MudText>
                        }
                        @foreach (var notification in NotificationList)
                        {
                            @if (notification.NotificationType == Enums.NotificationType.PageRequest)
                            {
                                var model = JsonSerializer.Deserialize<AdminPageRequestModel>(notification.DataJson);
                                <MudMenuItem OnClick="() => OpenRequestDialog(model, notification.NotifyId)">
                                    <ChildContent>
                                        <MudStack Row AlignItems="AlignItems.Center">
                                            <div style="flex: 1;">
                                                <PageRequestComponent Notify="notification" Model="model" IsNotification></PageRequestComponent>
                                            </div>
                                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error"
                                                           OnClick="() => DeleteNotification(notification)"/>
                                        </MudStack>
                                    </ChildContent>
                                </MudMenuItem>
                            }
                        }
                    </ChildContent>
                </MudMenu>
            </MudAppBar>
            <MudDrawer @bind-Open="@_open" Class="" ClipMode="DrawerClipMode.Docked" Elevation="1" Variant="@DrawerVariant.Responsive">
                <MudNavMenu>
                    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
                    <MudNavLink Href="/access-control" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Security">Access Control</MudNavLink>
                    <MudNavLink Match="NavLinkMatch.All" OnClick="ShowChangePassword" Icon="@Icons.Material.Filled.Lock">Change Password</MudNavLink>
                    <MudNavLink OnClick="Logout" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Logout">Logout</MudNavLink>
                </MudNavMenu>
            </MudDrawer>
            <MudMainContent>
                @Body
            </MudMainContent>
        </MudLayout>    
    </Authorized>
    <NotAuthorized>
        <PreLoaderComponent>
            <ChildComponent>
                @if (showForgotPassword)
                {
                    <ForgotPasswordComponent OnBackToLogin="() => showForgotPassword = false" ResetUrl="@_navigationManager.BaseUri"></ForgotPasswordComponent>
                }
                else
                {
                    <LoginComponent OnLoginSuccess="LoginCallback" OnForgotPasswordClick="() => showForgotPassword = true"></LoginComponent>
                }
            </ChildComponent>
        </PreLoaderComponent>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _open = false;
    private bool showForgotPassword = false;
    private List<NotifyModel> NotificationList = [];


    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        var authState = await _authenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is not null && user.Identity.IsAuthenticated)
        {
            await _hubNotificationService.StartAdminNotificationConnection();
            NotificationList = await _notificationService.GetAll();
        }
        _layoutNotifierService.OnAdminNotificationReceived += GetNotification;
    }

    private async Task LoginCallback()
    {
        NotificationList = await _notificationService.GetAll();
        StateHasChanged();
    }

    private async Task GetNotification(Guid id)
    {
        var notification = await _notificationService.GetByIdAsync(id);
        if (notification is not null)
        {
            NotificationList.Insert(0, notification);
            StateHasChanged();
        }
    }

    private void ToggleDrawer() => _open = !_open;

    private async Task Logout()
    {
        await _localStorage.RemoveItemAsync("token");
        ((CustomAuthenticationState)_authenticationStateProvider).NotifyUserLogout();
        await _hubNotificationService.StopConnectionAsyncAdmin();
        _navigationManager.NavigateTo("/", true);
    }

    private async Task OpenRequestDialog(AdminPageRequestModel request, Guid notificationId)
    {
        var options = new DialogOptions() { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = true, CloseButton = true };
        var parameters = new DialogParameters() { {"Model", request}, {"NotificationId", notificationId} };
        await _dialogService.ShowExAsync<RequestAdminDialog>(string.Empty, parameters, options);
    }

    private async Task DeleteNotification(NotifyModel notification)
    {
        await _notificationService.DeleteNotificationAsync(notification.NotifyId);
        NotificationList.Remove(notification);
        StateHasChanged();
    }

    private async Task ClearAllNotifications()
    {
        await _notificationService.ClearAllAsync();
        NotificationList.Clear();
        StateHasChanged();
    }

    private async Task ShowChangePassword()
    {
        await _dialogService.ShowAsync<ChangePasswordDialog>("", new DialogOptions()
        {
            MaxWidth = MaxWidth.Medium,
            CloseOnEscapeKey = false
        });
    }
}

<style>
    .notify-container {
        width: 350px;
        max-height: 500px;
        overflow-y: auto;
    }
</style>
