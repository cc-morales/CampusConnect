<MudDialog>
    <TitleContent>
        Reason
    </TitleContent>
    <DialogContent>
        <MudTextField T="string" @bind-Value="_reason" ShrinkLabel Margin="Margin.Dense" Label="Reason"></MudTextField>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Error" OnClick="Submit" Variant="Variant.Filled">Confirm Reject</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }
    
    private string _reason = string.Empty;
    
    private void Cancel() => MudDialog.Cancel();
    
    private void Submit() => MudDialog.Close(DialogResult.Ok(_reason));
}