@using Domain
@using Domain.Models
@using Microsoft.AspNetCore.Components.Forms
@using Service
@using Service.Interfaces
@using Shared.Component.Dialogs

@inject IOrganizationService _organizationService

<MudGrid Class="px-2 pt-2 relative"> 
    <MudItem Class="relative d-flex flex-column" xs="12">
        <MudFileUpload Class="@($"{(IsView ? "hide-badge" : "")} d-flex justify-center file-upload")" T="IBrowserFile" Accept="*" @bind-File="selectedCoverPhoto" FilesChanged="UploadCover" Style="width: 100%;" Disabled="IsView">
            <ActivatorContent>
                <MudBadge BadgeClass="mt-n5 ml-n4 badge-edit" Icon="@Icons.Material.Filled.CameraAlt" Origin="Origin.BottomRight" Overlap Bordered>
                    <MudImage Class="cover-photo rounded-lg" Elevation="1" Src="@Organization?.CoverPicture" Height="150"></MudImage>
                </MudBadge>
            </ActivatorContent>
        </MudFileUpload>
        <MudFileUpload Class=@($"{(IsView ? "hide-badge" : "")} d-flex justify-center absolute profile-container") T="IBrowserFile" Accept="*" @bind-File="selectedProfile" FilesChanged="UploadProfilePicture" Disabled="IsView">
            <ActivatorContent>
                <MudBadge BadgeClass="mt-n5 ml-n4 badge-edit" Icon="@Icons.Material.Filled.CameraAlt" Origin="Origin.BottomRight" Overlap Bordered>
                    <MudAvatar Size="Size.Large" Class="profile position-relative" Variant="Variant.Filled" Style="border : 1px solid #d3d3d3;">
                        <MudImage Src="@Organization?.ProfilePicture"></MudImage>
                    </MudAvatar>
                </MudBadge>
            </ActivatorContent>
        </MudFileUpload>
    </MudItem>

    <MudItem Class="flex-grow-1" xs="12">
        <MudStack Class="pa-2" Justify="Justify.Center" Spacing="2" Style="width: 100%;">

            <MudStack Class="pl-3">

                <MudText Typo="Typo.h6">@Organization?.OrganizationName</MudText>

                @if(MyDepartment is not null)
                {
                    <small style="color: blue">@MyDepartment.OrganizationName</small>
                }

            </MudStack>
            <MudDivider />

            <MudStack AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Row>
                <MudStack AlignItems="AlignItems.Center" Row>
                    <MudIcon Icon="@Icons.Material.Filled.House" Size="Size.Small"></MudIcon>
                    <small>Tibiao, Antique</small>
                </MudStack>
                
                <small><strong>@Organization?.Followers.Count Followers</strong></small>
            </MudStack>
            <MudStack AlignItems="AlignItems.Center" Row>
                <MudIcon Icon="@Icons.Material.Filled.Warehouse" Size="Size.Small"></MudIcon>
                <small>University of Antique Tario Lim Campus</small>
            </MudStack>

        </MudStack>

        @if (AppStateService?.CurrentUser?.Id == Organization?.User?.Id || Organization?.Contributors.Any(x => x.Id == AppStateService?.CurrentUser?.Id) is true)
        {
            <MudStack AlignItems="AlignItems.Center" Row>
                <MudChip T="string" OnClick="Post" Icon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium">POST</MudChip>
                @* <MudChip T="string" Icon="@Icons.Material.Filled.Edit" Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Medium">Edit</MudChip> *@
            </MudStack>
        }
        else 
        {

            <MudStack AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Row>
                <MudChip T="string"
                         OnClick="ToggleFollow"
                         Icon="@(IsFollowing() ? Icons.Material.Filled.Check : Icons.Material.Filled.PersonAdd)"
                         Variant="@(IsFollowing() ? Variant.Outlined : Variant.Filled)"
                         Color="Color.Primary"
                         Size="Size.Medium">
                    @(IsFollowing() ? "Following" : "Follow")
                </MudChip>
                <MudChip T="string" OnClick="RequestPage" Icon="" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium">Apply as Contributor</MudChip>
            </MudStack>
        }

        <MudDivider/>

    </MudItem>

</MudGrid>

@code {
    [Parameter] public MyOrganizationModel? Organization { get; set; }
    [Parameter] public bool IsView { get; set; } = false;
    [Parameter] public AppStateService? AppStateService { get; set; }

    [Inject] NavigationManager NavigationManager { get; set; } = null!;

    private List<MyOrganizationModel> OrganiztionList = new();
    private MyOrganizationModel? MyDepartment = new();
    private IBrowserFile? selectedCoverPhoto;
    private IBrowserFile? selectedProfile;

    protected override async  Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        MyDepartment = OrganiztionList.FirstOrDefault(x => x.MyOrganizationId == Organization?.OrganizationDepartment?.MyOrganizationId);

    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        OrganiztionList = await _organizationService.GetAllOrganizationsAsync();

    }

    private async Task UploadCover(IBrowserFile file)
    {
        selectedCoverPhoto = file;
        if (selectedCoverPhoto != null)
        {
            using (MemoryStream memoryStream = new MemoryStream())
            {
                await selectedCoverPhoto.OpenReadStream(209715200).CopyToAsync(memoryStream);

                Organization.CoverPhoto = memoryStream.ToArray();

                await _organizationService.UpdateOrganizationAsync(Organization);

                StateHasChanged();
            }
        }
    }

    private async Task UploadProfilePicture(IBrowserFile file)
    {
        selectedProfile = file;
        if (selectedProfile != null)
        {
            using (MemoryStream memoryStream = new MemoryStream())
            {
                await selectedProfile.OpenReadStream(209715200).CopyToAsync(memoryStream);

                Organization.Photo = memoryStream.ToArray();

                await _organizationService.UpdateOrganizationAsync(Organization);

                StateHasChanged();
            }
        }
    }

    private bool IsFollowing()
    {
        var userId = AppStateService?.CurrentUser?.Id;
        if (string.IsNullOrEmpty(userId) || Organization is null) return false;

        return Organization.Followers.Any(f => f.Id == userId);
    }

    private async Task ToggleFollow()
    {
        var userId = AppStateService?.CurrentUser?.Id;
        if (string.IsNullOrEmpty(userId) || Organization is null) return;

        await _organizationService.ToggleFollowAsync(Organization.MyOrganizationId, userId);

        var existing = Organization.Followers.FirstOrDefault(f => f.Id == userId);

        if (existing is not null)
            Organization.Followers.Remove(existing);
        else
            Organization.Followers.Add(new Follower
            {
                MyOrganizationId = Organization.MyOrganizationId,
                Id = userId
            });

        StateHasChanged();
    }

    private async Task Post()
    {
         NavigationManager.NavigateTo($"/post/{Organization.MyOrganizationId}");
    }
    
    private async Task RequestPage()
    {
        var dialog = await _dialogService.ShowAsync<RequestDialog>("", new DialogParameters()
        {
            { "PageRequestType", Enums.PageRequestType.Contributor },
            { "Organization", Organization}
        });

        var result = await dialog.Result;

    }


}

<style>
    .profile.mud-avatar.mud-avatar-large {
        height: 120px;
        width: 120px;
        border: 1px solid white;
    }   

    .cover-photo {
        width: 100%;
        object-fit: cover !important;
    }

    .badge-edit.mud-badge.mud-badge-bottom.right.mud-badge-overlap {
        height: 23px;
        width: 23px;
    }

    .badge-edit .mud-badge.mud-badge-icon .mud-icon-badge {
        font-size: 16px;
    }

    .file-upload .mud-badge-root {
        width: 100%;
        cursor: pointer;
    }

    .file-upload:not(.hide-badge) .mud-badge-root {
        cursor: pointer;
    }

    .profile-container {
        bottom: -25px;
        left: 30px;
    }

    .hide-badge .mud-badge {
        display: none !important;
    }
</style>